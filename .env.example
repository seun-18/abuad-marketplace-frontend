# XAMPP endpoints. The frontend detects these automatically when the values are omitted.
VITE_API_BASE_URL=http://localhost/Market_Place/backend/api
VITE_WS_URL=ws://localhost:8081

# Optional Paystack browser key.
# VITE_PAYSTACK_PUBLIC_KEY=

# Vercel + Northflank production example:
# VITE_API_BASE_URL=https://YOUR-API-SERVICE.code.run/api
# VITE_WS_URL=wss://YOUR-WEBSOCKET-SERVICE.code.run
